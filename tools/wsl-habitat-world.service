[Unit]
Description=Habitat legacy world compatibility status (retired mineflayer bot)
After=network.target habitat-agent.service
Wants=habitat-agent.service

[Service]
Type=oneshot
User=tlb3
Group=tlb3
# 世界由 mc / mc-launcher 适配器拥有；此单元只报告状态，不启动缺失依赖的旧 bot。
ExecStart=/opt/habitat/app/tools/legacy-world-status.sh
StandardOutput=append:/var/lib/habitat/logs/world.log
StandardError=append:/var/lib/habitat/logs/world.log

[Install]
WantedBy=multi-user.target
